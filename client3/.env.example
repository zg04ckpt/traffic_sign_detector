# Gateway base URL for Vite dev proxy (/api, /uploads, …).
#
# Local Spring Boot (api-gateway default port):
#   VITE_GATEWAY_URL=http://localhost:8081
#
# Kubernetes only — gateway exposed as NodePort:
#   VITE_GATEWAY_URL=http://localhost:30081
#
# Empty/unset uses vite.config.ts default (8081).
VITE_GATEWAY_URL=http://localhost:8081

# Optional absolute API base URL (leave empty to use relative paths + Vite proxy)
VITE_API_BASE_URL=
